# Neon Database
DATABASE_URL=postgres://[user]:[password]@[host]/pe_platform?sslmode=require

# Datagol API
DATAGOL_WORKSPACE_ID=your_workspace_id_here
DATAGOL_API_TOKEN=your_token_here
DATAGOL_EXTRACTION_ID=your_extraction_id_here
DATAGOL_BASE_URL=https://be.datagol.ai
DATAGOL_POLL_INTERVAL_MS=3000
DATAGOL_POLL_TIMEOUT_MS=180000
# Legacy option (only needed if direct upload flow is re-enabled)
DATAGOL_UPLOAD_ENDPOINT=/noCo/api/v2/workspaces/{workspaceId}/file/upload

# Ingestion jobs
INGEST_ASYNC_MODE=true
INGEST_JOB_RETENTION_MS=86400000

# App Config
PORT=8787
VITE_API_BASE_URL=http://localhost:8787
